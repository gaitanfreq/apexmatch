{
  "name": "football-analytics-backend",
  "version": "0.1.0",
  "description": "Backend de ingesta y almacenamiento para plataforma de analítica predictiva de fútbol",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "seed:demo": "node scripts/seed-demo-data.js",
    "seed:extra-leagues": "node scripts/seed-extra-leagues.js",
    "seed:admin": "node scripts/seed-admin.js",
    "backfill": "node src/ingestion/backfillHistorical.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "api": "node src/api/server.js",
    "dev:api": "node --watch src/api/server.js",
    "lint": "eslint src scripts",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "bottleneck": "^2.19.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "stripe": "^17.3.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
