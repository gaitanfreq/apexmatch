# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=football_analytics
PGUSER=football_app
PGPASSWORD=change_me
PG_MAX_POOL=10

# --- API-Football (RapidAPI o api-sports.io directo) ---
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=your_api_key_here

# --- Proveedor de clima (ej. OpenWeatherMap) ---
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_API_KEY=your_weather_api_key_here

# --- Ligas a sincronizar por defecto (ids de API-Football separados por coma) ---
# 39=Premier League, 140=La Liga, 135=Serie A, 78=Bundesliga, 61=Ligue 1
TRACKED_LEAGUE_IDS=39,140,135,78,61
CURRENT_SEASON_YEAR=2025

# --- Fuente de datos de partidos ---
# 'simulator' (default): genera partidos/cuotas automáticamente para Champions
#   League, La Liga, Premier League y Serie A sin necesitar una API_FOOTBALL_KEY
#   real — ver src/ingestion/matchSimulator.js. Útil para desarrollo/demo.
# 'api-football': usa los jobs reales de sincronización (backfill/fixtures/odds)
#   contra API_FOOTBALL_KEY — requiere una key válida y TRACKED_LEAGUE_IDS.
MATCH_DATA_SOURCE=simulator

# --- Logging ---
LOG_LEVEL=info

# --- API REST ---
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d
DEFAULT_BANKROLL=1000
KELLY_MULTIPLIER=0.25
MIN_EDGE=0.05
MIN_PARLAY_CUMULATIVE_PROBABILITY=0.85

# --- Cuenta Admin/Creador (npm run seed:admin) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_me_to_a_strong_password

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_VIP_PRICE_ID=price_your_vip_plan_id_here
STRIPE_SUCCESS_URL=http://localhost:3000/vip?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/vip?checkout=cancelled
